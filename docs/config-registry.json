{
  "config_version": {
    "type": "u32",
    "default": "1",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "preserve",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "must be <= CURRENT_CONFIG_VERSION",
    "examples": ["config.example.json", "config.direct.example.json"]
  },
  "mode": {
    "type": "string enum",
    "default": "apps_script",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/relay-modes.md",
    "validation": "must be one of apps_script|vercel_edge|direct|full (legacy google_only loads as direct)",
    "examples": ["config.example.json", "config.direct.example.json", "config.vercel-edge.example.json"]
  },
  "google_ip": {
    "type": "string (IPv4)",
    "default": "216.239.38.120",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "read/write (platform default differs)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "validated by readiness/doctor probes; optional deep validation",
    "examples": ["config.example.json", "config.direct.example.json"]
  },
  "front_domain": {
    "type": "string (hostname)",
    "default": "www.google.com",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "must be a DNS hostname; used for SNI-rewrite pool expansion",
    "examples": ["config.example.json", "config.direct.example.json"]
  },
  "listen_host": {
    "type": "string (ip/host bind)",
    "default": "127.0.0.1",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "default only (phone UI uses loopback)",
    "backend": "runtime",
    "docs": "docs/sharing-and-per-app-routing.md",
    "validation": "LAN exposure guidance + readiness warnings",
    "examples": ["config.example.json"]
  },
  "listen_port": {
    "type": "u16",
    "default": "8085",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "default only (Android uses 8080)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "must not conflict with socks5_port",
    "examples": ["config.example.json"]
  },
  "socks5_port": {
    "type": "u16 | null",
    "default": "8086",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "default only (Android uses 1081)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "must not conflict with listen_port",
    "examples": ["config.example.json"]
  },
  "log_level": {
    "type": "string",
    "default": "warn",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/troubleshooting.md",
    "validation": "accepted by tracing filter; invalid values fall back or fail parse depending on path",
    "examples": ["config.example.json"]
  },
  "verify_ssl": {
    "type": "bool",
    "default": "true",
    "modes": ["apps_script", "vercel_edge", "direct", "full"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/safety-security.md",
    "validation": "controls upstream TLS verification to targets; does not disable local MITM semantics",
    "examples": ["config.example.json"]
  },
  "hosts": {
    "type": "map<string,string>",
    "default": "{}",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "preserve (unknown-root merge)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "host override keys/values validated by routing logic",
    "examples": ["config.example.json"],
    "value_semantics": "JSON object mapping hostname keys to target strings (typically IPv4/IPv6 literals); routing consults this map so listed hosts bypass ordinary DNS for the resolved target. Keys are runtime hostname matches per README/MITM routing rules."
  },
  "enable_batching": {
    "type": "bool",
    "default": "false",
    "modes": ["apps_script"],
    "desktop": "preserve (hidden/compat)",
    "android": "preserve",
    "backend": "runtime",
    "docs": "docs/advanced-options.md",
    "validation": "compat knob; reserved for JSON batch envelopes",
    "examples": []
  },
  "upstream_socks5": {
    "type": "string | null",
    "default": "null",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "must parse as host:port; used for raw-TCP passthrough chaining",
    "examples": []
  },
  "parallel_relay": {
    "type": "u8",
    "default": "1",
    "modes": ["apps_script"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/advanced-options.md",
    "validation": "clamped to available healthy script IDs/groups",
    "examples": []
  },
  "coalesce_step_ms": {
    "type": "u16",
    "default": "0 (compiled default)",
    "modes": ["full"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/relay-modes.md",
    "validation": "0 uses compiled defaults; used for full-mode batch coalescing",
    "examples": []
  },
  "coalesce_max_ms": {
    "type": "u16",
    "default": "0 (compiled default)",
    "modes": ["full"],
    "desktop": "read/write",
    "android": "read/write",
    "backend": "runtime",
    "docs": "docs/relay-modes.md",
    "validation": "0 uses compiled defaults; used for full-mode batch coalescing",
    "examples": []
  },
