  "fronting_groups": {
    "type": "list<FrontingGroup>",
    "default": "[]",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "preserve (unknown-root merge + raw frontingGroupsJson)",
    "backend": "runtime",
    "docs": "docs/fronting-groups.md",
    "validation": "sni must be valid hostname; ip must be IP; domains list must be non-empty",
    "examples": ["config.fronting-groups.example.json"],
    "nested_fields": {
      "domains": {
        "type": "list<string>",
        "docs": "docs/fronting-groups.md",
        "validation": "non-empty; exact host + dot-anchored subdomains (case-insensitive)"
      },
      "ip": {
        "type": "string (IPv4/IPv6)",
        "docs": "docs/fronting-groups.md",
        "validation": "edge IP to dial for TLS to this group"
      },
      "name": {
        "type": "string",
        "docs": "docs/fronting-groups.md",
        "validation": "non-empty human-readable label for logs/docs"
      },
      "sni": {
        "type": "string (hostname)",
        "docs": "docs/fronting-groups.md",
        "validation": "upstream TLS SNI served by that edge IP"
      }
    }
  },
  "domain_overrides": {
    "type": "list<DomainOverride>",
    "default": "[]",
    "modes": ["apps_script", "vercel_edge", "direct"],
    "desktop": "read/write",
    "android": "preserve (unknown-root merge)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "host match syntax; force_route allowed values",
    "examples": [],
    "nested_fields": {
      "force_route": {
        "type": "string | null",
        "docs": "README.md",
        "validation": "omit/null for default routing; else direct | sni_rewrite | relay | full_tunnel"
      },
      "host": {
        "type": "string",
        "docs": "README.md",
        "validation": "exact hostname or suffix `.example.com` for subdomain match"
      },
      "never_chunk": {
        "type": "bool",
        "docs": "README.md",
        "validation": "when true, disable range-parallel chunking for this host"
      }
    }
  },
  "account_groups": {
    "type": "list<AccountGroup> | null",
    "default": "null",
    "modes": ["apps_script", "full"],
    "desktop": "read/write",
    "android": "read/write (simple projection + preserve advanced)",
    "backend": "runtime",
    "docs": "README.md",
    "validation": "required for apps_script/full; must include auth_key + >=1 script_id",
    "examples": ["config.example.json"],
    "nested_fields": {
      "auth_key": {
        "type": "string",
        "docs": "README.md",
        "validation": "required; must match AUTH_KEY in deployed Apps Script"
      },
      "enabled": {
        "type": "bool",
        "docs": "README.md",
        "validation": "default true; soft-disable a group without deleting it"
      },
      "label": {
        "type": "string | null",
        "docs": "README.md",
        "validation": "optional label for UI/logs"
      },
      "script_ids": {
        "type": "string | list<string>",
        "docs": "README.md",
        "validation": "one deployment ID or many; bare IDs or full /macros/s/ URLs normalized server-side"
      },
      "weight": {
        "type": "u8",
        "docs": "README.md",
        "validation": "relative priority when multiple groups are healthy; default 1"
      }
    }
  },
  "vercel": {
    "type": "object (VercelConfig)",
    "default": "{base_url:\"\", relay_path:\"/api/api\", auth_key:\"\", verify_tls:true, max_body_bytes:4MiB, enable_batching:false}",
    "modes": ["vercel_edge"],
    "desktop": "read/write",
    "android": "read/write (subset)",
    "backend": "runtime",
    "docs": "docs/vercel-json-relay.md",
    "validation": "base_url must be set; auth_key required; relay_path required",
    "examples": ["config.vercel-edge.example.json"],
    "nested_fields": {
      "auth_key": {
        "type": "string",
        "docs": "docs/vercel-json-relay.md",
        "validation": "required; shared secret matching serverless AUTH_KEY"
      },
      "base_url": {
        "type": "string (HTTPS origin)",
        "docs": "docs/vercel-json-relay.md",
        "validation": "deployment origin (Vercel, Netlify, or compatible)"
      },
      "enable_batching": {
        "type": "bool",
        "docs": "docs/vercel-json-relay.md",
        "validation": "reserved for JSON batch envelope; default false"
      },
      "max_body_bytes": {
        "type": "usize",
        "docs": "docs/vercel-json-relay.md",
        "validation": "decoded body cap per relay request; default 4MiB"
      },
      "relay_path": {
        "type": "string",
        "docs": "docs/vercel-json-relay.md",
        "validation": "must match deployed route; default /api/api"
      },
      "verify_tls": {
        "type": "bool",
        "docs": "docs/vercel-json-relay.md",
        "validation": "certificate verification for relay HTTPS; default true"
      }
    }
  },
