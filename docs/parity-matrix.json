{
  "backend_taxonomy": [
    "apps_script",
    "serverless_json",
    "tunnel_node"
  ],
  "modes": {
    "apps_script": {
      "label": "Apps Script (apps_script)",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["README.md", "docs/relay-modes.md", "docs/advanced-options.md"],
      "ci": ["cargo test --features ui", "apps_script helper tests", "readiness contract check"],
      "examples": ["config.example.json"],
      "notes": "Classic local MITM + Apps Script relay; requires account_groups."
    },
    "vercel_edge": {
      "label": "Serverless JSON (vercel_edge)",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["docs/vercel-json-relay.md", "docs/netlify-json-relay.md", "docs/relay-modes.md"],
      "ci": ["cargo test --features ui", "docs link+anchor checks"],
      "examples": ["config.vercel-edge.example.json"],
      "notes": "Native edge JSON relay; config key remains `vercel` for compatibility."
    },
    "direct": {
      "label": "Direct bootstrap (direct)",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["README.md", "docs/fronting-groups.md", "docs/relay-modes.md"],
      "ci": ["cargo test --features ui", "docs link+anchor checks"],
      "examples": ["config.direct.example.json", "config.fronting-groups.example.json"],
      "notes": "SNI-rewrite only; bootstrap for reaching Apps Script setup pages."
    },
    "full": {
      "label": "Full tunnel (full)",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["docs/relay-modes.md", "docs/udpgw.md", "tunnel-node/README.md"],
      "ci": ["tunnel-node clippy+tests", "cargo test --features ui"],
      "examples": ["config.full.example.json"],
      "notes": "End-to-end tunnel via Apps Script + tunnel-node; no local MITM required."
    }
  },
  "backends": {
    "apps_script": {
      "label": "Apps Script relay",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["assets/apps_script/README.md", "README.md"],
      "ci": ["Apps Script helper tests", "Apps Script syntax check"],
      "notes": "Deploy Code.gs/CodeFull.gs variants; compat probe via ?compat=1."
    },
    "serverless_json": {
      "label": "Serverless JSON relay (Vercel/Netlify)",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["docs/vercel-json-relay.md", "docs/netlify-json-relay.md"],
      "ci": ["JavaScript relay tools syntax", "cargo tests"],
      "notes": "Two providers share the same client contract under vercel.* config."
    },
    "tunnel_node": {
      "label": "tunnel-node",
      "desktop": "supported",
      "android": "supported",
      "runtime": "supported",
      "docs": ["tunnel-node/README.md", "docs/udpgw.md"],
      "ci": ["cargo clippy (tunnel-node)", "cargo test (tunnel-node)"],
      "notes": "Required only for full mode."
    }
  }
}
